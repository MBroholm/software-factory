        "jsCode": "const rows = $input.all().map(item => item.json);\nif (rows.length !== 1) throw new Error('Guard requires exactly one control row');\nconst row = rows[0];\nif (!Number.isInteger(row.id) || row.key !== 'global' || typeof row.busy !== 'boolean' ||\n    typeof row.execution_id !== 'string' || typeof row.started_at !== 'string' ||\n    !(row.issue_number === null || (Number.isInteger(row.issue_number) && row.issue_number > 0))) {\n  throw new Error('Invalid control row; no remote work or automatic repair');\n}\nconst expected = $('Prepare acquisition').first().json;\nif (row.id !== expected.id || row.busy !== true ||\n    row.execution_id !== expected.execution_id || row.started_at !== expected.started_at ||\n    row.issue_number !== expected.issue_number) {\n  throw new Error('Guard acquisition receipt not confirmed; stop and inspect, never assume idle');\n}\nreturn [{json:row}];"
