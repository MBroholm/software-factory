        460,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(item => item.json);\nif (rows.length !== 1) throw new Error('Guard requires exactly one control row');\nconst row = rows[0];\nif (!Number.isInteger(row.id) || row.key !== 'global' || typeof row.busy !== 'boolean' ||\n    typeof row.execution_id !== 'string' || typeof row.started_at !== 'string' ||\n    !(row.issue_number === null || (Number.isInteger(row.issue_number) && row.issue_number > 0))) {\n  throw new Error('Invalid control row; no remote work or automatic repair');\n}\nreturn [{json: {...row, guard_action: row.busy ? 'held' : 'acquire'}}];"
      }
    },
