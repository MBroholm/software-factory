# Copy to factory/local/test.env (ignored), then chmod 600 that file.
# Offline mapper reads only this file, with no shell expansion or process-env fallback.
FACTORY_TARGET=test

# ID of the existing factory_control Data Table in the TEST instance.
FACTORY_CONTROL_TABLE_ID=
# IDs of EXISTING saved Header Auth credentials in that same instance.
# GitHub: Authorization header. Gemini: x-goog-api-key header.
# Use credentials scoped for designated test resources; mapping does not sandbox HTTP.
FACTORY_GITHUB_CREDENTIAL_ID=
FACTORY_GEMINI_CREDENTIAL_ID=
# Optional display names; omit to retain source workflow names.
FACTORY_GITHUB_CREDENTIAL_NAME="Basic A GitHub Authorization"
FACTORY_GEMINI_CREDENTIAL_NAME="Basic A Gemini x-goog-api-key"

# Optional API access for separate isolated-test tooling. The OFFLINE mapper ignores both.
# This key authenticates to n8n itself; it is not a GitHub/Gemini API key.
N8N_BASE_URL=http://localhost:5679
N8N_API_KEY=
