# Copy to factory/local/operational.env (ignored), then chmod 600 that file.
# Offline mapper reads only this file, with no shell expansion or process-env fallback.
FACTORY_TARGET=operational

# ID of the existing factory_control Data Table in the OPERATIONAL instance.
FACTORY_CONTROL_TABLE_ID=
# IDs of EXISTING saved Header Auth credentials in that same instance.
# GitHub: Authorization header. Gemini: x-goog-api-key header.
# Use operational credentials; owner manual import remains required.
FACTORY_GITHUB_CREDENTIAL_ID=
FACTORY_GEMINI_CREDENTIAL_ID=
# Optional display names; omit to retain source workflow names.
FACTORY_GITHUB_CREDENTIAL_NAME="Basic A GitHub Authorization"
FACTORY_GEMINI_CREDENTIAL_NAME="Basic A Gemini x-goog-api-key"

# Optional API settings. The OFFLINE mapper ignores both; US3 tooling refuses this instance.
# This key authenticates to n8n itself; it is not a GitHub/Gemini API key.
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Basic B mapping. Use the saved n8n credential ID, never the bearer value.
FACTORY_RUNNER_CREDENTIAL_ID=
FACTORY_RUNNER_CREDENTIAL_NAME="Basic B Operational Runner Bearer"
FACTORY_RUNNER_URL=
# Must match model_config in the operational runner's config.toml.
FACTORY_RUNNER_MODEL_CONFIG=
